# Local API key whitelist file. One key per line.
WEB_API_KEYS_FILE=./script/api_keys.txt

# Public route prefixes.
WEB_API_PREFIX=/web-search/v1
WEB_API_COMPAT_PREFIX=/deepsearch/v1

# Service defaults.
WEB_API_DEFAULT_MODEL=roma-web-search
WEB_API_DEFAULT_TOP_N=24
WEB_API_MAX_TOP_N=200
WEB_API_STREAM_CHUNK_CHARS=600
WEB_API_STREAM_CHUNK_DELAY_MS=45
WEB_API_TASK_TTL_SECONDS=86400
WEB_API_WEB_BACKEND=skill_tree
WEB_API_ARTIFACT_DIR=./script/outputs

# Standalone script bundle integration.
ROMA_SRC_ROOT=./script/vendor/ROMA_v2/src
WEB_SEARCH_SKILL_ROOT=./script/skills/web-search-innospark-tree
WEB_SEARCH_UNION_ROOT=./script/skills/union-search-skill
WEB_SEARCH_NEWS_AGGREGATOR_ROOT=./script/skills/news-aggregator-skill
ACADEMIC_RESEARCH_SKILLS_ROOT=./script/skills/academic-research-skills
GOOGLE_SCHOLAR_SKILLS_ROOT=./script/skills/gs-skills

# Reuse the provider keys already used by ROMA / skill-tree scripts.
TAVILY_API_KEY=
