# Copy this file to .env on the server and fill provider keys there.

# Server binding used by run_server.py.
WEB_API_HOST=0.0.0.0
WEB_API_PORT=8110

# Local API-key whitelist. One key per line.
WEB_API_KEYS_FILE=./script/api_keys.txt

# Public route prefixes.
WEB_API_PREFIX=/web-search/v1
WEB_API_COMPAT_PREFIX=/deepsearch/v1

# Service defaults.
WEB_API_DEFAULT_MODEL=roma-web-search
WEB_API_DEFAULT_TOP_N=24
WEB_API_MAX_TOP_N=200
WEB_API_STREAM_CHUNK_CHARS=600
WEB_API_STREAM_CHUNK_DELAY_MS=45
WEB_API_TASK_TTL_SECONDS=86400
WEB_API_WEB_BACKEND=skill_tree
WEB_API_ARTIFACT_DIR=./script/outputs
WEB_API_HISTORY_FILE=./script/outputs/search_history.json

# The bundled defaults below usually do not need to be changed.
ROMA_SRC_ROOT=./script/vendor/ROMA_v2/src
WEB_SEARCH_SKILL_ROOT=./script/skills/web-search-innospark-tree
WEB_SEARCH_UNION_ROOT=./script/skills/union-search-skill
WEB_SEARCH_NEWS_AGGREGATOR_ROOT=./script/skills/news-aggregator-skill
ACADEMIC_RESEARCH_SKILLS_ROOT=./script/skills/academic-research-skills
GOOGLE_SCHOLAR_SKILLS_ROOT=./script/skills/gs-skills

# Provider credentials used by the bundled search skills.
# Core web/deep-search providers.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
TAVILY_API_KEYS=
TAVILY_SEARCH_DEPTH=basic
TAVILY_INCLUDE_ANSWER=false
SERPER_API_KEY=
SERPAPI_API_KEY=
SERPAPI_API_KEY_1=
SERPAPI_API_KEY_2=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
S2_API_KEY=
CROSSREF_MAILTO=
OPENALEX_MAILTO=

# Multi-platform and Chinese search providers.
TIKHUB_TOKEN=
YOUTUBE_API_KEY=
JINA_API_KEY=
BRAVE_API_KEY=
METASO_API_KEY=
VOLCENGINE_API_KEY=
BAIDU_QIANFAN_API_KEY=
GITHUB_TOKEN=

# Optional AI search/fetch providers. Leave blank if unused.
GROK_API_KEY=
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-1-fast
FIRECRAWL_API_KEY=
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2
EXA_API_KEY=

# Optional model/runtime credentials copied only when needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GEMINI_API_URL=
GEMINI_API_TOKEN=
GEMINI_MODEL=
RAGFLOW_API_URL=
RAGFLOW_API_KEY=
RAGFLOW_KB_ID=
