# ============================================================
# InnoSpark Intelligence Hub — 统一环境变量配置
# ============================================================
# 使用方法：
#   cp .env.example .env
#   各子系统脚本运行前先加载：
#   set -a && source ~/.claude/skills/web-search-innospark-tree/.env && set +a
#
# 密钥标注说明：
#   [必需]  — 缺少此 Key 该子系统核心功能无法运行
#   [推荐]  — 缺少时部分功能降级/跳过
#   [可选]  — 锦上添花，不影响核心功能
#   [未配置] — 暂未申请，保留占位
# ============================================================


# ============================================================
# 🕵️ 模块一：Intel Briefing — 情报日报系统
# 子系统根目录：Intel_Briefing/
# ============================================================

# [必需] GitHub Personal Access Token
# 用途：GitHub Trending GraphQL API（情报日报核心数据源）
# 获取：https://github.com/settings/tokens → 权限：public_repo 只读即可
GITHUB_TOKEN=your_github_token_here

# [推荐] xAI / Grok API Key
# 用途：X/Twitter 舆情分析、Alpha 雷达、营收分析师 LLM
# 获取：https://console.x.ai/（每月 $25 免费额度）
XAI_API_KEY=your_xai_api_key_here
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-1-fast

# [推荐] Product Hunt API Token
# 用途：Product Hunt 新品数据（情报日报产品板块）
# 获取：https://www.producthunt.com/v2/oauth/applications
PRODUCTHUNT_TOKEN=your_producthunt_token_here

# [未配置] Google Gemini API Key
# 用途：中文翻译（ArXiv 论文摘要等）
# 获取：https://aistudio.google.com/apikey（免费额度充足）
GEMINI_API_KEY=your_gemini_api_key_here


# ============================================================
# 🖥️ 模块二：OpenCLI — CLI 媒体内容采集
# 无需 API Key，使用 Chrome 浏览器登录 session
# ============================================================

# OpenCLI 守护进程端口（默认 19825，一般无需修改）
# OPENCLI_DAEMON_PORT=19825
# OPENCLI_BROWSER_CONNECT_TIMEOUT=30
# OPENCLI_BROWSER_COMMAND_TIMEOUT=45
# OPENCLI_BROWSER_EXPLORE_TIMEOUT=120
# OPENCLI_VERBOSE=


# ============================================================
# 🔍 模块三：UltimateSearchSkill — 双引擎深度搜索
# 子系统根目录：UltimateSearchSkill/
# ============================================================

# --- Grok 搜索配置 ---
# 直连模式（推荐，无需启动本地代理服务）
GROK_API_KEY=your_xai_api_key_here
GROK_API_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast

# --- Tavily 搜索配置 ---
# 直连模式（推荐）
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_URL=https://api.tavily.com

# --- FireCrawl 网页抓取（web-fetch.sh 降级方案）---
# 获取：https://www.firecrawl.dev/
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_API_URL=https://api.firecrawl.dev/v2

# --- 本地代理服务配置（多 Key 用户 / Cloudflare 绕过，单 Key 用户忽略此段）---
# 如启动了 grok2api 和 TavilyProxyManager 本地服务，取消下方注释并将上方直连改为代理地址
# GROK2API_PORT=8100
# GROK2API_APP_KEY=grok2api
# GROK2API_API_KEY=grok2api
# TAVILY_PROXY_PORT=8200
# TAVILY_MASTER_KEY=your_tavily_master_key_here

# 批量 Key 导入（用于 import-keys.sh 自动注册到代理服务）
# TAVILY_API_KEYS=your_tavily_api_key_here
# FIRECRAWL_API_KEYS=your_firecrawl_api_key_here


# ============================================================
# ⚡ 模块四：Union Search — 多平台联合搜索
# 子系统根目录：union-search-skill/
# ============================================================

# GITHUB_TOKEN 已在上方配置，共用
# 注：union-search-skill 原配置使用独立 Token，如遇权限问题可替换为：
# GITHUB_TOKEN=your_github_token_here

# [推荐] TikHub API Token
# 用途：小红书/抖音/Bilibili/Twitter 内容搜索
# 获取：https://tikhub.io/
TIKHUB_TOKEN=your_tikhub_token_here

# [推荐] Google Custom Search API
# 获取 API Key：https://console.cloud.google.com/ → Custom Search JSON API
# 获取 Search Engine ID：https://programmablesearchengine.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here

# TAVILY_API_KEY 已在上方 UltimateSearch 配置，共用

# [推荐] 秘塔搜索 Metaso API
# 用途：AI 驱动的中文智能摘要搜索
METASO_API_KEY=your_metaso_api_key_here

# [推荐] 火山引擎搜索 API
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# [推荐] SerpAPI（Bing 搜索备用 Key 轮询）
# 获取：https://serpapi.com/
SERPAPI_API_KEY_1=your_serpapi_key_here
SERPAPI_API_KEY_2=your_serpapi_key_here

# [推荐] YouTube Data API v3
# 获取：https://console.cloud.google.com/ → YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# [未配置] Jina AI API Key
# 获取：https://jina.ai/
JINA_API_KEY=jina_your_api_key_here

# [推荐] 知乎 Cookie（账号登录后从浏览器获取）
ZHIHU_COOKIE=your_zhihu_cookie_here

# [推荐] 微博搜索配置
WEIBO_USER_ID=your_weibo_user_id_here
WEIBO_COOKIE=your_weibo_cookie_here
WEIBO_FILTER=1
WEIBO_SINCE_DATE=2025-01-01
WEIBO_END_DATE=now
WEIBO_LIMIT=10

# 通用搜索引擎代理配置（无需 API Key，有代理时填入）
DUCKDUCKGO_PROXY=
BRAVE_PROXY=
YAHOO_PROXY=
BING_PROXY=
WIKIPEDIA_PROXY=
ANNASARCHIVE_PROXY=
JINA_PROXY=

# 图片搜索默认配置
IMAGE_SEARCH_OUTPUT=./image_downloads
IMAGE_SEARCH_NUM=10
IMAGE_SEARCH_THREADS=5
IMAGE_SEARCH_DELAY=1.0
IMAGE_SEARCH_KEYWORD=
IMAGE_SEARCH_PLATFORMS=


# ============================================================
# 🌐 模块五：Agent-Reach — 互联网访问层
# pip install agent-reach
# ============================================================

# [未配置] Exa AI 语义搜索
# 获取：https://exa.ai（免费 1000次/月）
# EXA_API_KEY=exa-your_key_here

# [未配置] Reddit 住宅代理（服务器上 Reddit 403 时必需）
# REDDIT_PROXY=http://user:pass@ip:port

# [未配置] Groq Whisper API（播客音频转录）
# 获取：https://console.groq.com（免费额度）
# GROQ_API_KEY=your_groq_api_key_here

# Twitter Cookie（通过 agent-reach configure 命令配置更安全）
# agent-reach configure twitter-cookies "<JSON>"
# AUTH_TOKEN=your_twitter_auth_token
# CT0=your_twitter_ct0_token


# ============================================================
# 📰 模块六：last30days — 30天主题研究
# 子系统根目录：last30days-skill/
# ============================================================

# [未配置] ScrapeCreators API Key
# 用途：Reddit / TikTok / Instagram 搜索（前100次免费）
# 获取：https://scrapecreators.com/
SCRAPECREATORS_API_KEY=your_scrapecreators_api_key_here

# XAI_API_KEY 已在上方配置，共用（用于 X/Twitter 搜索）

# [未配置] Brave Search API
# 获取：https://api.search.brave.com/
BRAVE_API_KEY=your_brave_search_api_key_here

# [未配置] OpenAI API（备用 LLM）
OPENAI_API_KEY=your_openai_api_key_here

# [未配置] OpenRouter API
# 获取：https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# [未配置] Parallel AI API
PARALLEL_API_KEY=your_parallel_api_key_here

# [未配置] Apify API Token
# 获取：https://apify.com/
APIFY_API_TOKEN=your_apify_api_token_here


# ============================================================
# 📊 模块七：News Aggregator — 28信源新闻聚合
# 零配置，无需任何 API Key
# HuggingFace Papers / Ben's Bites 需要 Playwright：
#   pip install playwright && playwright install chromium
# ============================================================


# ============================================================
# 🌐 全局代理配置（可选）
# 服务器部署 / 访问 Reddit、GitHub 等受限资源时启用
# ============================================================

# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# 注：httpx 不支持 socks5:// 代理，需要时安装：pip install httpx[socks]
# Clash: HTTP=7890, SOCKS=7891 | V2RayN: HTTP=10809, SOCKS=10808
