# Copy this file to .env on the server and fill provider keys there.

# Server binding used by run_server.py.
WEB_API_HOST=0.0.0.0
WEB_API_PORT=8099

# Local API-key whitelist. One key per line.
WEB_API_KEYS_FILE=./api_keys.txt

# Public route prefixes.
WEB_API_PREFIX=/web-search/v1
WEB_API_COMPAT_PREFIX=/deepsearch/v1

# Service defaults.
WEB_API_DEFAULT_MODEL=roma-web-search
WEB_API_DEFAULT_TOP_N=24
WEB_API_MAX_TOP_N=200
WEB_API_STREAM_CHUNK_CHARS=600
WEB_API_STREAM_CHUNK_DELAY_MS=45
WEB_API_TASK_TTL_SECONDS=86400
WEB_API_WEB_BACKEND=skill_tree
WEB_API_ARTIFACT_DIR=./outputs

# The bundled defaults below usually do not need to be changed.
ROMA_SRC_ROOT=./vendor/ROMA_v2/src
WEB_SEARCH_SKILL_ROOT=./skills/web-search-innospark-tree
WEB_SEARCH_UNION_ROOT=./skills/union-search-skill
WEB_SEARCH_NEWS_AGGREGATOR_ROOT=./skills/news-aggregator-skill
ACADEMIC_RESEARCH_SKILLS_ROOT=./skills/academic-research-skills
GOOGLE_SCHOLAR_SKILLS_ROOT=./skills/gs-skills

# Provider credentials used by the bundled search skills.
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
S2_API_KEY=
CROSSREF_MAILTO=
OPENALEX_MAILTO=
TIKHUB_TOKEN=
YOUTUBE_API_KEY=
JINA_API_KEY=
BRAVE_API_KEY=
METASO_API_KEY=
